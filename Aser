<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aser IT Service | Enterprise Tech Solutions</title>
    <!-- Google Fonts for Premium Typography -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style>
        /* Modern Premium CSS Reset & Variables */
        :root {
            --primary: #00ecbc;
            --secondary: #0072ff;
            --dark-bg: #0b0f19;
            --card-bg: #131a2c;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --gradient: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* Navigation Bar */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 5%;
            background: rgba(11, 15, 25, 0.8);
            backdrop-filter: blur(12px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 24px;
            font-weight: 700;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .btn-nav {
            background: var(--gradient);
            color: #000 !important;
            padding: 10px 20px;
            border-radius: 50px;
            font-weight: 600 !important;
        }

        /* Hero Banner Section */
        .hero {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            padding: 0 5%;
            margin-top: 0;
            background: linear-gradient(rgba(11, 15, 25, 0.85), rgba(11, 15, 25, 0.95)), url('banner.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .hero-content {
            max-width: 700px;
            z-index: 10;
        }

        .hero h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 56px;
            line-height: 1.1;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .hero h1 span {
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 18px;
            color: var(--text-muted);
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .cta-buttons {
            display: flex;
            gap: 20px;
        }

        .btn-primary {
            background: var(--gradient);
            color: #0b0f19;
            padding: 15px 35px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 4px 20px rgba(0, 236, 188, 0.2);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 30px rgba(0, 236, 188, 0.4);
        }

        .btn-secondary {
            border: 2px solid rgba(255, 255, 255, 0.1);
            color: var(--text-main);
            padding: 15px 35px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: background 0.3s, border-color 0.3s;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.3);
        }

        /* Section Global Settings */
        section {
            padding: 100px 5%;
        }

        .section-header {
            text-align: center;
            max-width: 600px;
            margin: 0 auto 60px;
        }

        .section-header h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 38px;
            margin-bottom: 15px;
        }

        .section-header p {
            color: var(--text-muted);
        }

        /* Premium Services Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: var(--card-bg);
            padding: 40px 30px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.03);
            transition: transform 0.3s, border-color 0.3s;
        }

        .service-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        .service-icon {
            font-size: 32px;
            margin-bottom: 20px;
            display: inline-block;
        }

        .service-card h3 {
            font-size: 22px;
            margin-bottom: 12px;
            font-family: 'Space Grotesk', sans-serif;
        }

        .service-card p {
            color: var(--text-muted);
            font-size: 15px;
            line-height: 1.6;
        }

        /* Premium Pricing Matrix */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .price-card {
            background: var(--card-bg);
            padding: 40px 30px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.03);
            text-align: center;
            position: relative;
        }

        .price-card.popular {
            border: 2px solid var(--primary);
            transform: scale(1.03);
        }

        .badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--gradient);
            color: #000;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 700;
        }

        .price {
            font-size: 42px;
            font-weight: 700;
            color: var(--text-main);
            margin: 20px 0;
            font-family: 'Space Grotesk', sans-serif;
        }

        .price span {
            font-size: 16px;
            color: var(--text-muted);
        }

        .features-list {
            list-style: none;
            margin: 30px 0;
            text-align: left;
        }

        .features-list li {
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 15px;
        }

        .features-list li::before {
            content: "✓";
            color: var(--primary);
            margin-right: 10px;
            font-weight: bold;
        }

        /* Contact Section Form */
        .contact-container {
            max-width: 600px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 40px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 14px;
            background: rgba(0,0,0,0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .form-group input:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
        }

        .btn-submit {
            width: 100%;
            background: var(--gradient);
            color: #0b0f19;
            border: none;
            padding: 16px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.3s;
        }

        .btn-submit:hover {
            opacity: 0.9;
        }

        /* Premium Minimalist Footer */
        footer {
            text-align: center;
            padding: 40px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Mobile Optimization overrides */
        @media (max-width: 768px) {
            .hero h1 { font-size: 38px; }
            .nav-links { display: none; }
            .price-card.popular { transform: scale(1); }
            section { padding: 60px 5%; }
        }
    </style>
</head>
<body>

